#!/usr/bin/env bash
# .githooks/pre-commit — praxis
#
# Ensures the generated Codex plugin package (plugins/praxis-codex/) stays
# in sync with canonical source. When you commit changes to canonical
# directories (skills/, agents/, workflows/, ...) OR to codex-plugin-assets/,
# this hook:
#
#   1. Runs scripts/build-codex-plugin.sh to regenerate plugins/praxis-codex/
#   2. Runs scripts/validate-codex-plugin.sh to verify the result
#   3. Re-stages any regenerated files so they're part of THIS commit
#
# Skips entirely if no relevant source files are staged (docs-only commits,
# hook-scaffolding commits, etc.).
#
# Fail-safe: if the build or validate fails, the commit is aborted with a
# non-zero exit and an error message. Fix the source, then re-commit.
#
# Install (one-time per clone):
#   scripts/install-git-hooks.sh
# or manually:
#   git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Directories that, when staged, require a Codex plugin rebuild
TRIGGERS=(
  "skills/"
  "agents/"
  "workflows/"
  "governance/"
  "references/"
  "patterns/"
  "scripts/"
  "hooks/"
  "codex-plugin-assets/"
  "antigravity-plugin-assets/"
  ".claude/commands/"
)

# Detect whether any staged file lives under a trigger path
needs_rebuild=0
staged_files="$(git diff --cached --name-only)"
for trigger in "${TRIGGERS[@]}"; do
  if echo "$staged_files" | grep -q "^$trigger"; then
    needs_rebuild=1
    break
  fi
done

if [[ $needs_rebuild -eq 0 ]]; then
  # Nothing that affects the Codex package — exit clean
  exit 0
fi

echo ""
echo "praxis pre-commit: canonical or Codex-overlay source changed"
echo "praxis pre-commit: regenerating plugins/praxis-codex/ ..."
echo ""

# Guard: build script must exist and be executable
if [[ ! -x scripts/build-codex-plugin.sh ]]; then
  echo "ERROR: scripts/build-codex-plugin.sh not found or not executable" >&2
  echo "       chmod +x scripts/build-codex-plugin.sh, then re-commit" >&2
  exit 1
fi

# Model-routing TOMLs must be regenerated from canonical source before the
# Codex build step runs — otherwise the build packages stale reasoning-effort
# assignments.
if ! python3 scripts/apply-model-routing.py --check; then
  echo ""
  echo "ERROR: run scripts/apply-model-routing.py and re-commit" >&2
  exit 1
fi

# Run the build
if ! scripts/build-codex-plugin.sh; then
  echo ""
  echo "ERROR: Codex plugin build failed." >&2
  echo "       Fix the source, then re-commit." >&2
  exit 1
fi

# Run validation (if present)
if [[ -x scripts/validate-codex-plugin.sh ]]; then
  if ! scripts/validate-codex-plugin.sh; then
    echo ""
    echo "ERROR: Codex plugin validation failed." >&2
    echo "       Fix the source, then re-commit." >&2
    exit 1
  fi
fi

# Re-stage any regenerated files so they land in THIS commit atomically
if [[ -n "$(git diff --name-only plugins/praxis-codex/ 2>/dev/null)" ]] \
   || [[ -n "$(git ls-files --others --exclude-standard plugins/praxis-codex/ 2>/dev/null)" ]]; then
  echo ""
  echo "praxis pre-commit: staging regenerated plugins/praxis-codex/"
  git add plugins/praxis-codex/
fi

# ----------------------------------------------------------------------
# Antigravity plugin package — same rebuild / validate / restage discipline.
# Its content is a SEPARATE artifact from Codex/Claude (own schema + own dir),
# so it is regenerated and staged independently.
# ----------------------------------------------------------------------
if [[ -x scripts/build-antigravity-plugin.sh ]]; then
  echo "praxis pre-commit: regenerating plugins/praxis-antigravity/ ..."
  if ! scripts/build-antigravity-plugin.sh; then
    echo "ERROR: Antigravity plugin build failed. Fix the source, then re-commit." >&2
    exit 1
  fi
  if [[ -x scripts/validate-antigravity-plugin.sh ]]; then
    if ! scripts/validate-antigravity-plugin.sh; then
      echo "ERROR: Antigravity plugin validation failed. Fix the source, then re-commit." >&2
      exit 1
    fi
  fi
  if [[ -n "$(git diff --name-only plugins/praxis-antigravity/ 2>/dev/null)" ]] \
     || [[ -n "$(git ls-files --others --exclude-standard plugins/praxis-antigravity/ 2>/dev/null)" ]]; then
    echo "praxis pre-commit: staging regenerated plugins/praxis-antigravity/"
    git add plugins/praxis-antigravity/
  fi
fi

# ----------------------------------------------------------------------
# Documentation reminder (non-blocking).
# If behavior-defining artifacts changed but no documentation surface did,
# remind the committer to double-check the docs before shipping.
# ----------------------------------------------------------------------
staged=$(git diff --cached --name-only)
core_changed=$(echo "$staged" | grep -E '^(agents/|skills/|workflows/|commands/|governance/|scripts/|hooks/)' || true)
docs_changed=$(echo "$staged" | grep -E '^(README\.md|INSTALLATION\.md|PLAYBOOK\.md|CHANGELOG\.md|ROADMAP\.md|docs/)' || true)
if [[ -n "$core_changed" && -z "$docs_changed" ]]; then
  echo ""
  echo "⚠  praxis pre-commit: you changed agents/skills/workflows/commands/scripts"
  echo "   but no documentation surface (README, INSTALLATION, PLAYBOOK, CHANGELOG,"
  echo "   ROADMAP, docs/). Double-check that the documentation still matches the"
  echo "   behavior you just changed — stale docs are the fastest way to lose users."
  echo "   (This is a reminder, not a block.)"
  echo ""
fi

echo ""
echo "praxis pre-commit: build + validation passed. Proceeding with commit."
echo ""
exit 0
